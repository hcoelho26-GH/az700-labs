## AZ-700 Lab 1 - Recursos ##
 
# Resource Group
az group create \
  --name $RG \
  --location $LOCATION_EASTUS
 
az group show --name $RG
 
 
# CoreServicesVnet - East US
az network vnet create \
  --resource-group $RG \
  --location $LOCATION_EASTUS \
  --name $VNET1_NAME \
  --address-prefix $VNET1_PREFIX \
  --subnet-name $VNET1_SUB1_NAME \
  --subnet-prefix $VNET1_SUB1
 
az network vnet subnet create \
  --resource-group $RG \
  --vnet-name $VNET1_NAME \
  --name $VNET1_SUB2_NAME \
  --address-prefix $VNET1_SUB2
 
az network vnet subnet create \
  --resource-group $RG \
  --vnet-name $VNET1_NAME \
  --name $VNET1_SUB3_NAME \
  --address-prefix $VNET1_SUB3
 
az network vnet subnet create \
  --resource-group $RG \
  --vnet-name $VNET1_NAME \
  --name $VNET1_SUB4_NAME \
  --address-prefix $VNET1_SUB4
 
az network vnet show \
  --resource-group $RG \
  --name $VNET1_NAME \
  --query "{Nome:name, Regiao:location, Prefixo:addressSpace.addressPrefixes}" \
  -o table
 
az network vnet subnet list \
  --resource-group $RG \
  --vnet-name $VNET1_NAME \
  --query "[].{Nome:name, Prefixo:addressPrefix}" \
  -o table
 
 
